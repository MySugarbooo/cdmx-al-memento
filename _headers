# Galería editorial y su catálogo: impedir que se conserve una versión desactualizada.
/fotografias/
  Cache-Control: no-cache, must-revalidate
/fotografias/index.html
  Cache-Control: no-cache, must-revalidate
/creditos-fotograficos.html
  Cache-Control: no-cache, must-revalidate
/assets/fotos/catalogo-editorial-1100.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Archivos de estilos compartidos: revalidar tras rediseños.
/styles.css
  Cache-Control: no-cache, must-revalidate
/assets/neo-site.css
  Cache-Control: no-cache, must-revalidate
/assets/neo-home.css
  Cache-Control: no-cache, must-revalidate
/assets/fotos/indice-noticias-1100.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Cache de imágenes editoriales: no afecta feeds, HTML, ni datos de noticias.
/assets/fotos/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/fotos/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Iconografía SVG con nombres y versiones propios.
/assets/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Scripts de portada versionados mediante sus URLs en HTML.
/assets/neo-home.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/assets/fotos.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
