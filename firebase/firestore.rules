rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function signedInGoogle() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function moderator() {
      // El privilegio se asigna con Admin SDK en servidor, nunca desde el navegador.
      return signedIn() && request.auth.token.get('moderator', false) == true;
    }
    function notBlocked() {
      return !exists(/databases/$(database)/documents/communityBans/$(request.auth.uid));
    }
    function verifiedName() {
      let claim = request.auth.token.get('name', '');
      return claim is string && claim.size() >= 1 && claim.size() <= 80
        ? claim : 'Lector';
    }
    function validPhoto(data) {
      let photo = data.get('photoURL', '');
      let verified = request.auth.token.get('picture', '');
      return photo is string && photo.size() <= 1500 &&
        (photo == '' ||
          (verified is string && verified.size() > 0 &&
           photo == verified && photo.matches('https://.+')));
    }
    function validComment() {
      return signedInGoogle() && notBlocked()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'photoURL'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == verifiedName()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && validPhoto(request.resource.data);
    }
    function validReport(reportId) {
      return signedInGoogle() && notBlocked()
        && request.resource.data.keys().hasOnly(['uid', 'commentId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'commentId', 'reason', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.commentId.matches('[a-zA-Z0-9]{20}')
        && reportId == request.auth.uid + '_' + request.resource.data.commentId
        && request.resource.data.reason in ['spam', 'abuso', 'privacidad', 'desinformacion', 'otro']
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/community/main/comments/$(request.resource.data.commentId));
    }
    match /articles/{articleId}/comments/{commentId} {
      function validArticle() {
        return articleId.matches('20[0-9]{2}-(0[1-9]|1[0-2])_[a-f0-9]{20}');
      }
      allow read: if validArticle();
      allow create: if validArticle() && validComment();
      allow update: if false;
      allow delete: if moderator() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /community/main/comments/{commentId} {
      allow read: if true;
      allow create: if validComment();
      allow update: if false;
      allow delete: if moderator() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // Etapa 3: solo el total de votos es público; las identidades no se listan.
    // Un voto y su total cambian en una misma transacción de Firestore.
    function voteTotalPath(commentId) {
      return /databases/$(database)/documents/community/main/voteTotals/$(commentId);
    }
    function myVotePath(commentId) {
      return /databases/$(database)/documents/community/main/votes/$(commentId)/users/$(request.auth.uid);
    }
    function validVoteCount() {
      return request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
    }
    function validVotedComment(commentId) {
      return commentId.matches('[a-zA-Z0-9]{20}')
        && exists(/databases/$(database)/documents/community/main/comments/$(commentId));
    }
    match /community/main/votes/{commentId}/users/{voterId} {
      // Solo el dueño puede saber si su cuenta votó; nunca se puede enumerar usuarios.
      allow get: if signedIn() && voterId == request.auth.uid;
      allow list: if false;
      allow create: if signedInGoogle() && notBlocked()
        && voterId == request.auth.uid
        && validVotedComment(commentId)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(voteTotalPath(commentId)).data.count ==
          (exists(voteTotalPath(commentId)) ? get(voteTotalPath(commentId)).data.count + 1 : 1);
      allow update: if false;
      allow delete: if signedInGoogle() && notBlocked()
        && voterId == request.auth.uid
        && exists(voteTotalPath(commentId))
        && get(voteTotalPath(commentId)).data.count > 0
        && getAfter(voteTotalPath(commentId)).data.count ==
          get(voteTotalPath(commentId)).data.count - 1;
    }
    match /community/main/voteTotals/{commentId} {
      allow read: if true;
      allow create: if signedInGoogle() && notBlocked()
        && validVotedComment(commentId) && validVoteCount()
        && request.resource.data.count == 1
        && !exists(myVotePath(commentId))
        && existsAfter(myVotePath(commentId))
        && getAfter(myVotePath(commentId)).data.createdAt == request.time;
      allow update: if signedInGoogle() && notBlocked()
        && validVoteCount()
        && (
          (request.resource.data.count == resource.data.count + 1
            && validVotedComment(commentId)
            && !exists(myVotePath(commentId))
            && existsAfter(myVotePath(commentId))
            && getAfter(myVotePath(commentId)).data.createdAt == request.time)
          ||
          (resource.data.count > 0
            && request.resource.data.count == resource.data.count - 1
            && exists(myVotePath(commentId))
            && !existsAfter(myVotePath(commentId)))
        );
      allow delete: if false;
    }
    match /community/main/reports/{reportId} {
      // Los reportes no son públicos: solo moderadores con rol firmado.
      allow read, delete: if moderator();
      allow create: if validReport(reportId);
      allow update: if false;
    }
    // Etapa 5: historial privado de decisiones tomadas desde el panel.
    // Cada acción requiere cerrar el reporte en la MISMA transacción.
    function moderationReportPath(reportId) {
      return /databases/$(database)/documents/community/main/reports/$(reportId);
    }
    function moderationCommentPath(commentId) {
      return /databases/$(database)/documents/community/main/comments/$(commentId);
    }
    function validModerationAction(actionId) {
      let data = request.resource.data;
      return moderator()
        && actionId.matches('[A-Za-z0-9]{20}')
        && data.keys().hasOnly(['actorUid', 'reportId', 'commentId',
          'action', 'reason', 'note', 'createdAt'])
        && data.keys().hasAll(['actorUid', 'reportId', 'commentId',
          'action', 'reason', 'note', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.reportId is string
        && data.reportId.matches('[A-Za-z0-9_-]{8,128}_[A-Za-z0-9]{20}')
        && data.commentId is string
        && data.commentId.matches('[A-Za-z0-9]{20}')
        && data.action in ['dismiss', 'remove']
        && data.reason in ['spam', 'abuso', 'privacidad', 'desinformacion', 'otro']
        && data.note is string && data.note.size() <= 240
        && data.createdAt == request.time
        && exists(moderationReportPath(data.reportId))
        && get(moderationReportPath(data.reportId)).data.commentId == data.commentId
        && get(moderationReportPath(data.reportId)).data.reason == data.reason
        && !existsAfter(moderationReportPath(data.reportId))
        && (data.action != 'remove' ||
            (exists(moderationCommentPath(data.commentId))
              && !existsAfter(moderationCommentPath(data.commentId))));
    }
    match /community/main/moderationActions/{actionId} {
      // Solo las cuentas con rol firmado pueden leer o crear entradas.
      // Ningún cliente puede editarlas ni borrarlas después.
      allow read: if moderator();
      allow create: if validModerationAction(actionId);
      allow update, delete: if false;
    }
    // Etapa 9: reportes ciudadanos independientes del foro.
    // Los borradores privados solo los ven su autor y moderadores.
    // SOLO la proyección aprobada, sin UID, se muestra al público.
    function citizenPrivatePath(reportId) {
      return /databases/$(database)/documents/citizenReports/$(reportId);
    }
    function citizenPublicPath(reportId) {
      return /databases/$(database)/documents/citizenReportsPublic/$(reportId);
    }
    function citizenBorough(value) {
      return value in [
        'Álvaro Obregón', 'Azcapotzalco', 'Benito Juárez', 'Coyoacán',
        'Cuajimalpa de Morelos', 'Cuauhtémoc', 'Gustavo A. Madero',
        'Iztacalco', 'Iztapalapa', 'La Magdalena Contreras',
        'Miguel Hidalgo', 'Milpa Alta', 'Tláhuac', 'Tlalpan',
        'Venustiano Carranza', 'Xochimilco'
      ];
    }
    function citizenCategory(value) {
      return value in ['baches', 'fugas', 'alumbrado', 'basura',
        'banquetas', 'transporte', 'otro'];
    }
    function validCitizenFields(data) {
      return data.keys().hasOnly([
          'uid', 'borough', 'colonia', 'category', 'title', 'description',
          'status', 'createdAt', 'updatedAt', 'moderatedBy'
        ])
        && data.keys().hasAll([
          'uid', 'borough', 'colonia', 'category', 'title', 'description',
          'status', 'createdAt', 'updatedAt', 'moderatedBy'
        ])
        && data.uid is string && data.uid.size() >= 8 && data.uid.size() <= 128
        && citizenBorough(data.borough)
        && citizenCategory(data.category)
        && data.colonia is string && data.colonia.size() <= 70
        && data.title is string && data.title.size() >= 8 && data.title.size() <= 110
        && data.description is string && data.description.size() >= 20
        && data.description.size() <= 900
        && data.moderatedBy is string && data.moderatedBy.size() <= 128;
    }
    function validCitizenSubmission(reportId) {
      let data = request.resource.data;
      return signedInGoogle() && notBlocked()
        && reportId.matches('[A-Za-z0-9]{20}')
        && validCitizenFields(data)
        && data.uid == request.auth.uid
        && data.status == 'pending'
        && data.moderatedBy == ''
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }
    function matchingCitizenPublic(pub, priv) {
      return pub.keys().hasOnly([
          'borough', 'colonia', 'category', 'title', 'description',
          'status', 'createdAt', 'updatedAt'
        ])
        && pub.keys().hasAll([
          'borough', 'colonia', 'category', 'title', 'description',
          'status', 'createdAt', 'updatedAt'
        ])
        && pub.borough == priv.borough
        && pub.colonia == priv.colonia
        && pub.category == priv.category
        && pub.title == priv.title
        && pub.description == priv.description
        && pub.status == priv.status
        && pub.createdAt == priv.createdAt
        && pub.updatedAt == priv.updatedAt
        && pub.status in ['published', 'closed'];
    }
    function validCitizenModeration(reportId) {
      let next = request.resource.data;
      let previous = resource.data;
      return moderator()
        && validCitizenFields(next)
        && next.diff(previous).affectedKeys().hasOnly([
          'status', 'moderatedBy', 'updatedAt'
        ])
        && next.moderatedBy == request.auth.uid
        && next.updatedAt == request.time
        && (
          (previous.status == 'pending'
            && next.status in ['published', 'rejected'])
          || (previous.status == 'published'
            && next.status in ['closed', 'rejected'])
          || (previous.status == 'closed' && next.status == 'rejected')
        )
        && (
          (next.status in ['published', 'closed']
            && existsAfter(citizenPublicPath(reportId))
            && matchingCitizenPublic(
              getAfter(citizenPublicPath(reportId)).data, next
            ))
          || (next.status == 'rejected'
            && !existsAfter(citizenPublicPath(reportId)))
        );
    }
    match /citizenReports/{reportId} {
      // Se lee únicamente con rol moderador o desde la cuenta autora.
      // Las consultas de un usuario deben incluir where('uid','==',auth.uid).
      allow get, list: if moderator() ||
        (signedInGoogle() && resource.data.uid == request.auth.uid);
      allow create: if validCitizenSubmission(reportId);
      allow update: if validCitizenModeration(reportId);
      allow delete: if signedInGoogle() && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'rejected'];
    }
    match /citizenReportsPublic/{reportId} {
      // No contiene UID, nombre, correo, fotografía ni teléfono del autor.
      allow read: if true;
      allow create: if moderator()
        && reportId.matches('[A-Za-z0-9]{20}')
        && exists(citizenPrivatePath(reportId))
        && get(citizenPrivatePath(reportId)).data.status == 'pending'
        && existsAfter(citizenPrivatePath(reportId))
        && getAfter(citizenPrivatePath(reportId)).data.status == 'published'
        && matchingCitizenPublic(request.resource.data,
          getAfter(citizenPrivatePath(reportId)).data);
      allow update: if moderator()
        && resource.data.status == 'published'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && existsAfter(citizenPrivatePath(reportId))
        && getAfter(citizenPrivatePath(reportId)).data.status == 'closed'
        && matchingCitizenPublic(request.resource.data,
          getAfter(citizenPrivatePath(reportId)).data);
      allow delete: if moderator()
        && existsAfter(citizenPrivatePath(reportId))
        && getAfter(citizenPrivatePath(reportId)).data.status == 'rejected';
    }

    match /communityBans/{uid} {
      // Bloqueos gestionados únicamente con Admin SDK / consola administrativa.
      allow read, write: if false;
    }
  }
}
