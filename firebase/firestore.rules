rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validComment() {
      return signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && !(request.resource.data.name.size() > 80)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && !(request.resource.data.text.size() > 1000)
        && request.resource.data.createdAt == request.time;
    }
    match /articles/{articleId}/comments/{commentId} {
      function validArticle() {
        return articleId.matches('20[0-9]{2}-(0[1-9]|1[0-2])_[a-f0-9]{20}');
      }
      allow read: if validArticle();
      allow create: if validArticle() && validComment();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /community/main/comments/{commentId} {
      allow read: if true;
      allow create: if validComment();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
